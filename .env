# =============================================================
# INVEXIS FRONTEND — PRODUCTION ENVIRONMENT VARIABLES
# =============================================================
# Copy ALL of these EXACT values into your cloud hosting platform
# (Vercel / Railway / Render / etc.) under Environment Variables.
# DO NOT change NEXTAUTH_URL from invexix.com — this is critical for iOS.
# =============================================================

# ------------------------------------------------------------------
# BACKEND API — HTTP REST endpoint (no trailing slash)
# ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.invexix.com/api

# ------------------------------------------------------------------
# BACKEND WEBSOCKET — used for real-time notifications
# Must be wss:// (secure WebSocket) in production
# ------------------------------------------------------------------
NEXT_PUBLIC_API_URL_SW=wss://api.invexix.com

# ------------------------------------------------------------------
# APP PUBLIC URL — the frontend domain (no trailing slash)
# Used for SEO metadata, OG tags, sitemap, and robots.txt
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://invexix.com

# ------------------------------------------------------------------
# NEXT-AUTH — CRITICAL FOR iOS SAFARI
# NEXTAUTH_URL must EXACTLY match the public URL users access.
# On iOS, Safari strictly validates this for CSRF and cookie domain.
# NEVER set this to localhost in production.
# ------------------------------------------------------------------
NEXTAUTH_URL=https://invexix.com
NEXTAUTH_URL_INTERNAL=http://localhost:3000
NEXTAUTH_SECRET=Ry/lBcSzNIurWNRe22bqdeTNwsCqFfpskuvD++eW6a0=

# ------------------------------------------------------------------
# GOOGLE OAUTH (optional — only needed if Google sign-in is enabled)
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=852570446494-b1t2g03jo8rl68ni8gb3g6ohkfh9d1le.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# ------------------------------------------------------------------
# CURRENCY API
# ------------------------------------------------------------------
NEXT_PUBLIC_CURRENCY_API_KEY=fca_live_pD4DCg5lkPY4Rex4xXkov8Q9pfHOdGIfGdrTFKQA

# ------------------------------------------------------------------
# APP PHASE — set to "production" so dev-only UI (DevBypassToggle etc.) is hidden
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_PHASE=production

# ------------------------------------------------------------------
# AUTH BYPASS — must be false in production (never expose dev bypass)
# ------------------------------------------------------------------
NEXT_PUBLIC_BYPASS_AUTH=false

